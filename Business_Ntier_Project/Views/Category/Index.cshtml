@using Entity_Layer.Concrete
@model List<Category>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<h1>Here is the Category Page</h1>
<table class="table table-bordered">

    <tr>
        <th >Category ID</th>
        <th >Category Name </th>
        <th >Delete</th>
        <th >Update</th>
    </tr>

    @foreach (var item in Model)
    {
        
        <tr>
            <td >@item.Id</td>
            <td >@item.Name</td>
            <td>
                <a href="/Category/UpdateCategory/@item.Id" class="btn btn-success">Update</a>
            </td>
            <td >
                <a href="/Category/DeleteCategory/@item.Id" class="btn btn-danger">Delete</a>
            </td>
            


        </tr>

    }
</table>
<a href="/Category/AddCategory/" class="btn btn-primary"> Add Category</a>
