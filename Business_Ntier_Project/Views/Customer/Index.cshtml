@using Entity_Layer.Concrete
@model List<Customer>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<h1>Here is Customer Page</h1>

<table class="table table-bordered table-striped-columns">
    
    
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>City</th>
            <th>Update</th>
            <th>Delete</th>

        </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.City</td>
            <td>
                <a href="/Customer/UpdateCustomer/@item.Id" class="btn btn-success">Update</a>
            </td>
            <td>
                <a href="/Customer/DeleteCustomer/@item.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }

</table>

<a href="/Customer/AddCustomer/" class="btn btn-info">Add Customer</a>

