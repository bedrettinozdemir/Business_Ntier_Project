@using Entity_Layer.Concrete
@model List<Product>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<h1>Product Page</h1>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Update</th>
        <th>Delete</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
        
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>@item.Stock</td>
            <td>
                <a href="/Product/UpdateProduct/@item.Id" class="btn btn-success"
                >Update</a>
            </td>
            <td>
                <a href="/Product/DeleteProduct/@item.Id" class="btn btn-danger">Delete</a>
            </td>
        
        </tr>
    }
</table>
<a href="/Product/AddProduct" class="btn btn-primary">Add Product</a>
